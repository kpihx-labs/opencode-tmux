{
  "name": "opencode-tmux",
  "version": "1.0.0",
  "description": "First-class OpenCode plugin & tools for tmux pane orchestration, AUTO/FREE write locks, multi-subscriber watches, and event-driven shell-return notifications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "opencode",
    "plugin",
    "tmux",
    "hitl",
    "terminal",
    "notifications"
  ],
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com:kpihx-labs/opencode-tmux.git"
  },
  "bugs": {
    "url": "https://gitlab.com/kpihx-labs/opencode-tmux/-/issues"
  },
  "homepage": "https://gitlab.com/kpihx-labs/opencode-tmux#readme",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@opencode-ai/plugin": "^1.18.16",
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
